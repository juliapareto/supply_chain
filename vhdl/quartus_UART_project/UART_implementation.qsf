set_global_assignment -name FAMILY "MAX 10"
set_global_assignment -name DEVICE 10M50DAF484C7G
set_global_assignment -name TOP_LEVEL_ENTITY UART_MEMO_Top_ARDUINO_LOOP
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 24.1STD.0
set_global_assignment -name PROJECT_CREATION_TIME_DATE "22:34:47  APRIL 27, 2025"
set_global_assignment -name LAST_QUARTUS_VERSION "24.1std.0 Lite Edition"
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85
set_global_assignment -name ERROR_CHECK_FREQUENCY_DIVISOR 256
set_global_assignment -name EDA_SIMULATION_TOOL "Questa Intel FPGA (VHDL)"
set_global_assignment -name EDA_TIME_SCALE "1 ps" -section_id eda_simulation
set_global_assignment -name EDA_OUTPUT_DATA_FORMAT VHDL -section_id eda_simulation
set_global_assignment -name EDA_GENERATE_FUNCTIONAL_NETLIST OFF -section_id eda_board_design_timing
set_global_assignment -name EDA_GENERATE_FUNCTIONAL_NETLIST OFF -section_id eda_board_design_symbol
set_global_assignment -name EDA_GENERATE_FUNCTIONAL_NETLIST OFF -section_id eda_board_design_signal_integrity
set_global_assignment -name EDA_GENERATE_FUNCTIONAL_NETLIST OFF -section_id eda_board_design_boundary_scan
set_global_assignment -name POWER_PRESET_COOLING_SOLUTION "23 MM HEAT SINK WITH 200 LFPM AIRFLOW"
set_global_assignment -name POWER_BOARD_THERMAL_MODEL "NONE (CONSERVATIVE)"



# I/O Standards


#CLOCK



set_location_assignment PIN_N14 -to i_Clk

# RESET -- on KEY[0]

set_location_assignment PIN_B8 -to reset


# UART Pin Assignments


set_location_assignment PIN_V10 -to i_RX_Serial
set_location_assignment PIN_W10 -to o_TX_Serial

# SWITCHES





set_location_assignment PIN_C10 -to i_SW_0
set_location_assignment PIN_C11 -to i_SW_1
set_location_assignment PIN_D12 -to i_SW_2
set_location_assignment PIN_C12 -to i_SW_3
set_location_assignment PIN_A12 -to i_SW_4
set_location_assignment PIN_B12 -to i_SW_5
set_location_assignment PIN_A13 -to i_SW_6
set_location_assignment PIN_A14 -to i_SW_7
set_location_assignment PIN_B14 -to i_SW_DV






# LEDS








set_location_assignment PIN_A8 -to o_LED_0
set_location_assignment PIN_A9 -to o_LED_1
set_location_assignment PIN_A10 -to o_LED_2
set_location_assignment PIN_B10 -to o_LED_3
set_location_assignment PIN_D13 -to o_LED_4
set_location_assignment PIN_C13 -to o_LED_5
set_location_assignment PIN_E14 -to o_LED_6
set_location_assignment PIN_D14 -to o_LED_7




set_global_assignment -name VHDL_FILE UART_Top_LOOP.vhd
set_global_assignment -name VHDL_FILE UART_RX.vhd
set_global_assignment -name VHDL_FILE UART_TX.vhd
set_global_assignment -name VHDL_FILE UART_implementation.vhd
set_global_assignment -name VHDL_FILE UART_TOP_tb_simple.vhd
set_global_assignment -name VHDL_FILE UART_TOP_tb_advanced.vhd
set_global_assignment -name VHDL_FILE top_testbench_L.vhd
set_global_assignment -name VHDL_FILE Memo_Control.vhd
set_global_assignment -name VHDL_FILE UART_Memo_Top.vhd
set_global_assignment -name VHDL_FILE atom_netlists/UART_Memo_TB.vhd
set_global_assignment -name VHDL_FILE UART_SWITCHES_INPUT.vhd
set_global_assignment -name VHDL_FILE UART_LED_OUTPUT.vhd
set_global_assignment -name VHDL_FILE UART_Memo_Top_LOOP.vhd
set_global_assignment -name VHDL_FILE UART_MEMO_Top_LOOP.vhd
set_global_assignment -name VHDL_FILE UART_MEMO_Top_ARDUINO_LOOP.vhd
set_global_assignment -name VHDL_FILE Memo_Control_Ard.vhd
set_global_assignment -name VHDL_FILE UART_MEMO_Top_ARDUINO_SEND.vhd
set_global_assignment -name VHDL_FILE Memo_Control_Ard_SEND.vhd
set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top
set_instance_assignment -name IO_STANDARD "3.3 V SCHMITT TRIGGER" -to reset
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to *
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to i_Clk
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to i_RX_Serial
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to o_TX_Serial
