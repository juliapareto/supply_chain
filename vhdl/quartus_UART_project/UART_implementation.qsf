set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to i_SW_7
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to i_SW_DV
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to o_LED_0
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to o_LED_1
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to o_LED_2
